# Normalise line endings and mark binary fixtures.
* text=auto eol=lf
*.java text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.cff text eol=lf
Makefile text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.jar binary
*.bin binary
*.png binary
*.jpg binary
*.gif binary
